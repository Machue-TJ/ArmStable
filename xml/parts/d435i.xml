<mujocoinclude>
  <!-- Eye-in-hand mount, relative to link6 (metres, wxyz quaternion).
       Offset 65 mm to the side; optical axis tilted 0.95 rad toward link6 +X.
       This is an assumed bracket transform, not measured hand-eye calibration.
       MuJoCo cameras look along -Z, with +X right and +Y up. -->
  <body name="d435i_mount" pos="-0.047 0 0.065"
        quat="0 0.7071 0.7071 0" gravcomp="0">
    <!-- Datasheet nominal 75 g; uniform-box inertia remains an approximation.
         Camera weight is a real load, not automatically gravity compensated. -->
    <inertial pos="0 0 0" mass="0.075"
              diaginertia="0.0000078125 0.00005453125 0.00005453125"/>
    <geom name="d435i_housing" type="box" size="0.045 0.0125 0.0125"
          rgba="0.18 0.18 0.20 1" group="2" contype="0" conaffinity="0"/>
    <geom name="d435i_collision" type="box" size="0.045 0.0125 0.0125"
          group="3" rgba="0.2 0.2 0.2 0.2"/>
    <geom name="d435i_front" type="box" size="0.043 0.0105 0.0005"
          pos="0 0 -0.0125" rgba="0.03 0.03 0.03 1" group="2"
          contype="0" conaffinity="0"/>
    <!-- Nominal realsense-ros geometry: 50 mm stereo baseline, color 15 mm
         left of depth. Depth origin 4.2 mm behind glass, glass 0.1 mm inset.
         Python sets independent fx/fy from stream profiles/calibration. -->
    <camera name="d435i_rgb" mode="fixed" pos="-0.0325 0 -0.0082" fovy="42"/>
    <camera name="d435i_depth" mode="fixed" pos="-0.0175 0 -0.0082" fovy="58"/>
    <camera name="d435i_ir_right" mode="fixed" pos="0.0325 0 -0.0082" fovy="58"/>
    <site name="d435i_optical_site" pos="-0.0175 0 -0.0082" quat="0 1 0 0" size="0.002"
          rgba="1 0.8 0 1" group="4"/>
    <!-- Nominal IMU offset relative to depth in optical axes:
         (0.00552, -0.0051, -0.01174) m. -->
    <site name="d435i_imu_site" pos="-0.01198 0.0051 0.00354" quat="0 1 0 0"
          size="0.001" rgba="0 1 1 1" group="4"/>
  </body>
</mujocoinclude>
